[Unit]
Description=taOS on-device LLM (llama.cpp router mode, LFM3-1.7B, opt-in)
# OPT-IN: this unit is installed but never enabled and has no [Install]
# section. Phone agents use the taOS host's models over the network by default;
# this model is for offline use and quick replies. `taos-llm start` brings it up
# and it stops itself after TAOS_LLM_IDLE_MIN idle minutes (taos-llm-idle).
#
# The unit name, port and models dir are taOS core's llama.cpp contract
# (tinyagentos/installers/llamacpp_installer.py, app-catalog/services/llama-cpp):
# core probes 127.0.0.1:@PORT@/health and auto-registers the backend. The
# binary is Alpine's llama-server package (musl); core's own installer fetches
# a glibc release binary, which cannot run here.
After=network.target
# The thermal cap and the idle auto-stop ride along with every start, however
# it was started, and are bound to this unit (they stop when it stops).
Wants=taos-llm-thermal.service taos-llm-idle.service

[Service]
Type=simple
# The controller's user: the models dir lives inside its data dir, which is
# taos:taos 0700, so no other user can reach it.
User=@USER@
# @MODELS_DIR@, @PORT@ and @USER@ are filled in by install-llama-cpp.sh.
# CPU only: 2 threads on 2 big cores. Decode is memory-bandwidth bound, so a
# third core added about 1 percent (13.38 against 13.24 tok/s) and 4.7 C.
# --ctx-size 16384: the 15-case tool test needs at least 12288.
# Sampling sits on the server (LFM3 values from @Strata-dev's Pi runs). A
# request's own sampling fields still beat these; read GET /slots to see what
# a request actually used.
ExecStart=/usr/bin/llama-server --models-dir @MODELS_DIR@ --models-max 1 \
  --host 127.0.0.1 --port @PORT@ --jinja --ctx-size 16384 --parallel 1 \
  -t 2 -tb 2 \
  --temp 0.1 --top-k 50 --top-p 1.0 --min-p 0 --repeat-penalty 1.1
Restart=on-failure
RestartSec=3

# Two of the four big cores; cpu4 stays free for taos-sttd/taos-ttsd and the
# little cores for the shell.
CPUAffinity=5 6
Nice=5
# If the phone runs short of memory, lose the model before the UI.
OOMScoreAdjust=300

NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
IPAddressAllow=localhost
IPAddressDeny=any
