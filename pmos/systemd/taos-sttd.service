[Unit]
Description=taOS local speech-to-text (sherpa-onnx, Parakeet-TDT 0.6b v3 int8)
Documentation=file://@PREFIX@/NOTICE
# LIFECYCLE: RESIDENT (always running). Cold-loading the model takes about
# 3.8 s (3.1 s warm; bench RESULTS-v2.md), which would land on the FIRST
# push-to-talk. Resident costs about 1.1 GB RSS (bench peak 1107 MB; the
# handset's measured figure: 1098 MB RSS, 1106 MB peak), with MemAvailable around
# 9.4 GB while taOS runs, so the memory is affordable and the delay is not.

[Service]
# Type=notify: `systemctl start` returns only once the model is loaded and
# /health answers 200, so "active" means "ready", not "loading".
Type=notify
NotifyAccess=main
User=taos-stt
# @PREFIX@, @MODEL_DIR@ and @PORT@ are filled in by install-stt.sh (the install
# prefix, the model dir inside the controller's unified model store, the port).
ExecStart=/usr/bin/python3 @PREFIX@/bin/taos-sttd
Environment=TAOS_STT_MODEL_DIR=@MODEL_DIR@ TAOS_STT_LIB=@PREFIX@/lib/libsherpa-onnx-c-api.so
Environment=TAOS_STT_PORT=@PORT@ TAOS_STT_THREADS=4
TimeoutStartSec=120
Restart=on-failure
RestartSec=3

# The four big cores (4-7), alone: the bench's best setting (RTF ~0.09), and it
# keeps the little cores free for the shell. taos-ttsd is pinned to 4-7 too (Kitten
# needs the big cores); the two overlap only on barge-in, to be measured.
CPUAffinity=4-7
Nice=5
# If the phone runs short of memory, lose the recognizer before the UI.
OOMScoreAdjust=300

# Hardening. Loopback only, no privileges, read-only filesystem, no home.
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
# The model store sits under /root on this phone, so ProtectHome=yes would hide
# it. Measured with systemd-run on the handset: ProtectHome=tmpfs or =yes plus
# BindReadOnlyPaths= alone gave "Permission denied" on the bound dir; adding
# TemporaryFileSystem=/root:ro made it work. Net effect: /home and /root are
# empty tmpfs, and the model dir alone is bound back in, read-only.
ProtectHome=tmpfs
TemporaryFileSystem=/root:ro
BindReadOnlyPaths=@MODEL_DIR@
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077
IPAddressAllow=localhost
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
