[Unit]
Description=taOS local text-to-speech (sherpa-onnx VITS, Piper en_GB-cori-high)
Documentation=file://@PREFIX@/NOTICE
# LIFECYCLE: RESIDENT (always running): cold load 2.4 s, peak RSS 345 MB
# (measured on the handset 10-01). Loading on demand would put the load delay in front of the first
# spoken reply; resident it costs the model's memory.

[Service]
# Type=notify: `systemctl start` returns only once the model is loaded and
# /health answers 200, so "active" means "ready", not "loading".
Type=notify
NotifyAccess=main
User=taos-tts
# @PREFIX@, @LIB@, @MODEL_DIR@ and @PORT@ are filled in by install-tts.sh (the
# install prefix, the ONE sherpa-onnx library that install-stt.sh builds, the
# model dir inside the controller's unified model store, the port).
ExecStart=/usr/bin/python3 @PREFIX@/bin/taos-ttsd
Environment=TAOS_TTS_MODEL_DIR=@MODEL_DIR@ TAOS_TTS_LIB=@LIB@
Environment=TAOS_TTS_PORT=@PORT@ TAOS_TTS_THREADS=4 TAOS_TTS_SID=0
TimeoutStartSec=60
Restart=on-failure
RestartSec=3

# The four big cores (4-7), like taos-sttd.
# MEASURED on the handset 10-01 (taOSmobile voice/tts-piper, 11.6 s reply, 5 runs
# each, medians): cores 4-7 alone RTF 0.64, first audio 2.7 s; cores 0-3 alone RTF
# 2.73, first audio 12.0 s (far slower than real time, so the little cores are
# ruled out); 4-7 while taos-sttd decodes on 4-7 at the same time (barge-in) RTF
# 1.47, first audio 6.6 s, and STT slows 0.105 -> 0.41; TTS on 0-3 with STT on 4-7
# RTF 3.22. Cold load 2.4 s, peak RSS 345 MB. First audio is one sentence's
# synthesis, so it scales with the length of the reply's first sentence.
# STT finishes before a reply is synthesised, so in a normal turn the two do
# not overlap.
CPUAffinity=4-7
Nice=5
# If the phone runs short of memory, lose the synthesizer before the UI.
OOMScoreAdjust=300

# Hardening. Loopback only, no privileges, read-only filesystem, no home.
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
# The model store sits under /root on this phone, so ProtectHome=yes would hide
# it. As for taos-sttd (measured there with systemd-run on the handset):
# ProtectHome=tmpfs plus TemporaryFileSystem=/root:ro makes /home and /root
# empty, and the model dir alone is bound back in, read-only.
ProtectHome=tmpfs
TemporaryFileSystem=/root:ro
BindReadOnlyPaths=@MODEL_DIR@
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077
IPAddressAllow=localhost
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
