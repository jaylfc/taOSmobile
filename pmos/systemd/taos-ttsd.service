[Unit]
Description=taOS local text-to-speech (sherpa-onnx, Kitten nano v0.8 fp32, expr-voice-2-m)
Documentation=file://@PREFIX@/NOTICE
# LIFECYCLE: RESIDENT (always running). Bench figures (RESULTS-v2.md, measured
# on the handset by the bench harness, not yet by this daemon): cold load
# 1.29 s (0.81 s warm), peak RSS 328 MB. Loading on demand would put that delay
# in front of the first spoken reply; resident it costs about a third of a GB.

[Service]
# Type=notify: `systemctl start` returns only once the model is loaded and
# /health answers 200, so "active" means "ready", not "loading".
Type=notify
NotifyAccess=main
User=taos-tts
# @PREFIX@, @LIB@, @MODEL_DIR@ and @PORT@ are filled in by install-tts.sh (the
# install prefix, the ONE sherpa-onnx library that install-stt.sh builds, the
# model dir inside the controller's unified model store, the port).
ExecStart=/usr/bin/python3 @PREFIX@/bin/taos-ttsd
Environment=TAOS_TTS_MODEL_DIR=@MODEL_DIR@ TAOS_TTS_LIB=@LIB@
Environment=TAOS_TTS_PORT=@PORT@ TAOS_TTS_THREADS=4 TAOS_TTS_SID=0
TimeoutStartSec=60
Restart=on-failure
RestartSec=3

# The four big cores (4-7), like taos-sttd: Kitten nano runs at RTF 0.19-0.22
# there but 0.78 on the four little cores (bench), too close to real time to
# stream. STT finishes before a reply is synthesised, so in a normal turn the
# two do not overlap; barge-in (both at once on 4-7) is to be measured on the
# device, not assumed.
CPUAffinity=4-7
Nice=5
# If the phone runs short of memory, lose the synthesizer before the UI.
OOMScoreAdjust=300

# Hardening. Loopback only, no privileges, read-only filesystem, no home.
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
# The model store sits under /root on this phone, so ProtectHome=yes would hide
# it. As for taos-sttd (measured there with systemd-run on the handset):
# ProtectHome=tmpfs plus TemporaryFileSystem=/root:ro makes /home and /root
# empty, and the model dir alone is bound back in, read-only.
ProtectHome=tmpfs
TemporaryFileSystem=/root:ro
BindReadOnlyPaths=@MODEL_DIR@
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077
IPAddressAllow=localhost
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
