39d604f91a8cb5bdb358fda05902a67de6403b99e5cba8d094b18f463cc1520cf80a43e2a60acf7fcfff85b9d4b0c57f64cedba8d080acd2f809b0c699683490  usb-signaller.initd
bee42df9764170a8fb32d570edbfd9867f0a1c1a3e3198c0725044d379a6199769efc7e4cb50aca02ad3617e4d1298654e4409dd3f6f725a21f1bef8f4acc67e  0001-udc-classify-own-ncm-gadgets-by-name.patch
