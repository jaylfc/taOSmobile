[Unit]
Description=taOS camera service (libcamera)
Documentation=file:/usr/share/taos/camera/README
After=multi-user.target

[Service]
Type=simple
User=taos
Group=taos
SupplementaryGroups=video render
ExecStart=/usr/bin/python3 /usr/lib/taos/taos-camerad.py
Restart=on-failure
RestartSec=3
# The camera can come up without its software ISP if the previous instance has
# not finished letting go of the media device. camerad exits 75 when it sees
# that, so a restart must always be allowed rather than rate-limited into a
# permanent failure.
RestartPreventExitStatus=
StartLimitIntervalSec=0
# The sensors are the only hardware this touches, and it answers on loopback
# only. Everything else is closed off so a service reachable from a page that
# renders BEFORE sign-in cannot become a way into the rest of the device.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=no
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_UNIX
# ⛔ NO DeviceAllow HERE, DELIBERATELY. Naming even one switches DevicePolicy
# from auto to CLOSED, and the closed list has to be exhaustive. It bit twice:
# first /dev/media0 (dynamic major, so `char-video4linux` does not cover it)
# and the service reported ZERO cameras; then, with the media nodes and the
# dma-heaps both allowed, libcamera STILL could not attach its software ISP and
# handed out packed-bayer frames that decoded as striped noise. The converter
# reaches for more than a list can be trusted to enumerate.
#
# The security this bought was thin -- the service already runs as an
# unprivileged user whose access to the sensors comes from the video/render
# groups -- and the cost was a camera that looked broken twice. Everything
# else below stays.
ReadWritePaths=/home/taos/Pictures

[Install]
WantedBy=multi-user.target
