#!/bin/sh
# Toggle the panel, the way a phone's power key does.
#
# WHY A SCRIPT AND NOT `output * power toggle`: sway REFUSES toggle against the
# wildcard -- `swaymsg "output * power toggle"` answers
#   {"success": false, "parse_error": true,
#    "error": "Cannot apply toggle to all outputs"}
# and, because a bindsym's exec output goes nowhere, the key silently did
# nothing. Measured on the device 2026-09-16. `off` and `on` DO accept the
# wildcard, so read the current state and send the explicit one.
set -eu

# --raw so the reply is one JSON object per line rather than pretty-printed;
# busybox has no jq, and the first "power" field is the panel we care about
# (this is a single-output handset).
state=$(swaymsg -t get_outputs --raw 2>/dev/null \
        | grep -o '"power": *[a-z]*' \
        | head -1 \
        | sed 's/.*: *//')

if [ "$state" = "true" ]; then
    exec swaymsg "output * power off"
fi

swaymsg "output * power on"

# RE-ARM THE IDLE WATCHER. This is the whole reason this is not a two-line
# script. Powering the output on over the IPC produces NO INPUT EVENT, so
# swayidle never sees its `resume` and stays latched in the idle state it
# entered when the screen went off -- and a latched swayidle never reaches its
# timeout again. The observable symptom is a phone whose screen, once woken with
# the POWER KEY rather than a touch, stays lit forever. Measured on the device
# 2026-09-16 after Jay reported exactly that.
#
# Waking by TOUCH does not need this: a touch is a real input event, so swayidle
# resumes and re-arms on its own. Only the IPC path is affected.
#
# Respawned through `swaymsg exec` rather than backgrounded from this script.
# The compositor then owns the new watcher: it starts inside the sway session
# with the session's environment (SWAYSOCK, XDG_RUNTIME_DIR, the idle timeout)
# and inside its cgroup. A plain `setsid ... &` from here is an orphan in
# whatever context happened to run the key handler, and it was MEASURED being
# reaped immediately on this image -- leaving no idle watcher at all, which is
# strictly worse than the latched one it replaced.
#
# taos-kiosk-idle kills the previous instance before starting, so this cannot
# stack watchers no matter how often the key is pressed.
swaymsg exec -- /usr/local/bin/taos-kiosk-idle >/dev/null 2>&1 || true
