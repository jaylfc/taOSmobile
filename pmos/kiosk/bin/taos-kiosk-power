#!/bin/sh
# Toggle the panel, the way a phone's power key does.
#
# WHY A SCRIPT AND NOT `output * power toggle`: sway REFUSES toggle against the
# wildcard -- `swaymsg "output * power toggle"` answers
#   {"success": false, "parse_error": true,
#    "error": "Cannot apply toggle to all outputs"}
# and, because a bindsym's exec output goes nowhere, the key silently did
# nothing. Measured on the device 2026-09-16. `off` and `on` DO accept the
# wildcard, so read the current state and send the explicit one.
set -eu

# --raw so the reply is one JSON object per line rather than pretty-printed;
# busybox has no jq, and the first "power" field is the panel we care about
# (this is a single-output handset).
state=$(swaymsg -t get_outputs --raw 2>/dev/null \
        | grep -o '"power": *[a-z]*' \
        | head -1 \
        | sed 's/.*: *//')

if [ "$state" = "true" ]; then
    # Tell the page the screen is going dark so it can put an open sheet away.
    # Jay: "if I turn the screen off on the power menu it should also dismiss
    # the menu" -- otherwise the menu is still up behind a black screen and the
    # next wake lands on a stale one, which reads as the phone being stuck.
    #
    # Fired BEFORE the panel goes off, while the page can still act on it, and
    # with a short timeout so a wedged controller can never stop the screen
    # turning off. The screen is the point; the dismissal is the courtesy.
    curl -sS --max-time 2 -X POST \
        "http://127.0.0.1:${TAOS_PORT:-6969}/auth/lock-screen-off" \
        >/dev/null 2>&1 || true
    exec /usr/local/bin/taos-kiosk-screen off
fi

exec /usr/local/bin/taos-kiosk-screen on

# THE IDLE RE-ARM MOVED to taos-kiosk-screen, which is now the only place that
# powers the panel on. Keeping a second copy here would respawn the watcher
# twice per press; keeping it here INSTEAD would leave every other wake path
# (the double tap) latched. One owner, at the point the panel actually comes on.
