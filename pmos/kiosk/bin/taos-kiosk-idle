#!/bin/sh
# Idle -> display power off, inside the kiosk compositor.
#
# WHY A SCRIPT: sway's config grammar uses `;` as its OWN command separator, so
# an inline `exec_always pkill -x swayidle; swayidle -w ...` parses as TWO sway
# commands -- the exec runs `pkill` only and the rest is fed to sway as an
# unknown command, leaving the session with NO idle handling at all. Measured on
# the device 2026-09-16: swayidle was simply absent and the panel never blanked.
# Keeping the whole thing in a file means sway only ever sees one bare word.
set -eu

# ONE VALUE drives the screen timeout: SCREEN_OFF_SECONDS in
# /etc/taos/display.conf. A Settings screen writes that file; this reads it at
# start, and `swaymsg exec /usr/local/bin/taos-kiosk-idle` applies a new value
# without a restart. 0 means never. The file is PARSED, never sourced: it is
# meant to be written by a settings UI, and a sourced file is code.
# TAOS_KIOSK_IDLE_SECS (exported by the launcher) is only the fallback for a
# device with no display.conf.
CONF="${TAOS_DISPLAY_CONF:-/etc/taos/display.conf}"
if [ -r "$CONF" ]; then
    # The file exists: it alone decides. A malformed one means 30, never the
    # launcher's value, which could be 0 and switch the timeout off silently.
    IDLE_SECS="$(sed -n 's/^SCREEN_OFF_SECONDS=\([0-9][0-9]*\)[[:space:]]*$/\1/p' "$CONF" | tail -n 1)"
    if [ -z "$IDLE_SECS" ]; then
        echo "taos-kiosk-idle: no valid SCREEN_OFF_SECONDS in $CONF, using 30" >&2
        IDLE_SECS=30
    fi
else
    IDLE_SECS="${TAOS_KIOSK_IDLE_SECS:-30}"
fi
case "$IDLE_SECS" in
    ''|*[!0-9]*) IDLE_SECS=30 ;;
    ?????*)
        # More digits than the range can have. Refused here, before any
        # arithmetic: a number too large for the shell makes `[ -ne ]` fail
        # with an error, which would skip the range test below.
        echo "taos-kiosk-idle: SCREEN_OFF_SECONDS=$IDLE_SECS is outside 5..3600, using 30" >&2
        IDLE_SECS=30 ;;
esac
# A timeout under 5 s makes the phone unusable and locks its owner out of the
# setting that would fix it; over an hour is "never" spelled badly.
if [ "$IDLE_SECS" -ne 0 ] && { [ "$IDLE_SECS" -lt 5 ] || [ "$IDLE_SECS" -gt 3600 ]; }; then
    echo "taos-kiosk-idle: SCREEN_OFF_SECONDS=$IDLE_SECS is outside 5..3600, using 30" >&2
    IDLE_SECS=30
fi

# exec_always re-runs this on `swaymsg reload`, so drop a previous instance
# first or each reload leaves another swayidle racing the last one. -x matches
# the exact process name, so this shell (sh) is never a match for itself.
pkill -x swayidle 2>/dev/null || true

# `output * power off` is wlr-output-power-management: the panel is POWERED
# DOWN, not dimmed, and sway gates input while it is off so a touch wakes the
# screen rather than pressing whatever is under the finger.
# NO `resume` POWER-ON. This used to carry
#     resume 'swaymsg "output * power on"'
# which lit the panel on ANY input -- a stray touch in a pocket, a knee, the
# desk. Jay, from the glass: "Tap to wake just worked, i think it does sometimes
# just not when i want it to!" That unpredictability IS the bug; waking on
# everything and waking reliably are not the same property.
#
# taos-kiosk-dt2w owns the wake now and requires a deliberate double tap.
# swayidle still sees the touch as input, so it resumes and re-arms its own
# timeout -- which is why this does not hit the latch documented in
# taos-kiosk-power, where an IPC-only wake leaves swayidle stuck for good.
#
# THE POWER KEY REMAINS THE FALLBACK, bound with --locked in sway.conf: if the
# daemon is dead the screen is still reachable.
# taos-kiosk-screen, not a bare `output * power off`: turning the screen off
# also has to GATE TOUCH, or taps in a pocket press whatever is under the finger
# on the lock screen. Jay reported exactly that. One script owns both halves so
# the three callers -- this, the power key and the double-tap watcher -- cannot
# drift apart again.
if [ "$IDLE_SECS" -eq 0 ]; then
    # Never: no idle timeout, but the panel still goes off before suspend.
    exec swayidle -w \
        before-sleep '/usr/local/bin/taos-kiosk-screen off'
fi
exec swayidle -w \
    timeout "$IDLE_SECS" '/usr/local/bin/taos-kiosk-screen off' \
    before-sleep         '/usr/local/bin/taos-kiosk-screen off'
