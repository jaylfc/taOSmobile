#!/bin/sh
# Turn the panel off or on, and gate TOUCH with it.
#
# WHY THIS EXISTS AS ITS OWN SCRIPT: "the screen is off" is two facts, not one --
# the output is powered down AND the digitiser must not reach the page. Three
# callers need both (the idle watcher, the power key, the double-tap watcher),
# and when each did its own half they drifted apart. Jay, from the glass:
# "Touchscreen is still registering events when the screen is off" -- taps in a
# pocket were pressing whatever was under the finger on the lock screen.
#
# THE REGRESSION THIS FIXES IS MINE. sway used to swallow the first touch
# because swayidle's `resume` was what powered the output back on, so the touch
# that woke the phone never reached the surface. Requiring a DOUBLE tap meant
# removing that `resume`, which also removed the swallowing -- so single touches
# started landing on the page while the screen was dark. The gate has to be
# explicit now that the wake is.
#
# ORDER IS DELIBERATE IN BOTH DIRECTIONS, and it is the whole point:
#   off: disable touch FIRST, then power down -- otherwise there is a window
#        where the screen is dark and the digitiser is still live, which is
#        exactly the bug.
#   on:  power up FIRST, then enable touch -- otherwise there is a window where
#        touch is live and the user cannot see what they are pressing.
#
# ⚠ SAFETY: with touch disabled, the ONLY way back is the power key, which is
# bound in sway with --locked and calls this script with `on`. So a dead
# double-tap watcher costs the double-tap, never the phone. Do not add a path
# that disables touch without leaving that key able to re-enable it.
set -eu

# type:touch rather than the identifier 0:0:fts_ts: a replacement digitiser or a
# kernel that renames the device would silently stop matching, and the failure
# mode of a non-matching selector here is the pocket-touch bug coming back with
# nothing in the logs.
TOUCH='type:touch'

touch_events() {
    swaymsg "input $TOUCH events $1" >/dev/null 2>&1 || true
}

# Tell the page the panel is going down or coming up.
#
# WHY THIS MATTERS AND IS NOT COSMETIC: the page CANNOT PAINT while the output
# is off -- Wayland stops delivering frame callbacks to a surface on a
# powered-down output. So whatever a waking panel shows is the last frame
# painted BEFORE it blanked, held in the scanout buffer. Jay, twice: "the lock
# screen still flashes into view first." It was that stale frame, not a
# transition.
#
# So the page is blackened here, while a compositor is still listening, and the
# pause is for it to actually paint that frame. Told on the way back too, or it
# would stay black on a lit panel.
page() {
    curl -sS --max-time 2 -X POST -H "X-taOS-Console: 1" \
        "http://127.0.0.1:${TAOS_PORT:-6969}/auth/lock-screen-$1" \
        >/dev/null 2>&1 || true
}

# Is the screen black right now? Reads a 4 px wide strip down the middle of the
# output: the closing animation ends on a thin line at the centre, so a strip
# through the centre is black only once that line has gone too.
#
# `timeout`, always: grim BLOCKS FOREVER on an output that is off (it has no
# capture formats to offer). An off request for a panel that is already off
# hung here, and the moment the panel next came on, the stuck request finished
# its job and switched it straight off again: the phone could not be woken.
is_black() {
    _f="${XDG_RUNTIME_DIR:-/tmp}/taos-black-probe.$$"
    timeout 1 grim -g "${TAOS_BLACK_PROBE:-268,0 4x1200}" -t ppm - > "$_f" 2>/dev/null || { rm -f "$_f"; return 1; }
    # The image is three header lines ("P6", "W H", "255") and then raw
    # samples. Count ONLY the samples: with the header counted and a small
    # allowance for it, one white row of the strip still passed as black, and
    # the closing animation ends on exactly such a line.
    _h="$(head -n 3 "$_f" | wc -c)"
    _all="$(wc -c < "$_f")"
    _n="$(tail -c +"$((_h + 1))" "$_f" | tr -d '\000-\020' | wc -c)"
    rm -f "$_f"
    case "$_h$_all$_n" in ''|*[!0-9]*) return 1 ;; esac
    # Some samples must exist, and none may be brighter than 16.
    [ "$_all" -gt "$_h" ] && [ "$_n" -eq 0 ]
}

# Is any output powered? An off request often arrives for a panel that is
# already off (the idle timer fires again, the power key after a timeout).
# Three answers, because "could not ask" is not "dark": 0 lit, 1 dark, 2 unknown.
# Only a successful answer that shows no powered output counts as dark.
panel_state() {
    _o="$(swaymsg -t get_outputs -r 2>/dev/null)" || return 2
    case "$_o" in
        *'"power": true'*|*'"power":true'*) return 0 ;;
        *'"power"'*) return 1 ;;
        *) return 2 ;;
    esac
}

# A wake stamps this file. An off that was still waiting for black when the
# wake arrived must not then switch the panel off under it: it compares the
# stamp it saw at the start with the stamp at the end.
WAKE_STAMP="${XDG_RUNTIME_DIR:-/tmp}/taos-screen.wake"
wake_stamp() { cat "$WAKE_STAMP" 2>/dev/null || echo none; }

# Wait for black, at most TAOS_BLACK_WAIT_MS (2 s); the cap means a page that
# never blackens costs time, not the screen-off. LOOK FIRST, then sleep: this
# used to sleep 150 ms before the first look "to leave a frame's time", which
# guaranteed nothing a look does not and cost 150 ms on every screen-off. With
# the page already black the whole off path measured 337 to 515 ms.
wait_black() {
    _cap="${TAOS_BLACK_WAIT_MS:-2000}"
    case "$_cap" in ''|*[!0-9]*) _cap=2000 ;; esac
    _t0="$(date +%s%N 2>/dev/null)"
    case "$_t0" in ''|*[!0-9]*) sleep 0.6; return 0 ;; esac
    while :; do
        # Nothing to wait for, and nothing grim could read, on a dark panel.
        # An unknown state keeps looking: the looks are time-limited anyway.
        _ps=0; panel_state || _ps=$?
        [ "$_ps" -eq 1 ] && return 0
        # A wake arrived: stop waiting, the caller will stand down.
        [ "$(wake_stamp)" = "${_stamp0:-none}" ] || return 0
        is_black && return 0
        _el=$(( ( $(date +%s%N) - _t0 ) / 1000000 ))
        if [ "$_el" -ge "$_cap" ]; then
            echo "taos-kiosk-screen: screen still not black after ${_el} ms, powering off anyway" >&2
            return 0
        fi
        sleep 0.03
    done
}

case "${1:-}" in
off)
    # The page now closes the lock screen into the centre over 0.5 s (Jay:
    # "close into the centre ... a quick 0.5 second animation", ls-tv-off),
    # and nothing paints once the output is down, so wait it out: the last
    # frame on the panel must be the black it ends on. This was 0.12 s, which
    # only had to cover one black frame; 50 ms over the animation leaves room
    # for chromium to composite that frame on a busy phone.
    #
    # A fixed 0.55 s was not enough, measured 2026-11-17: the first frame after
    # a wake was the lock face, half faded, with the PREVIOUS minute on its
    # clock -- the frame the panel was holding when the power went, because the
    # animation had not finished. The message has to reach the page first, and
    # when the phone slept UNLOCKED the shell has to load the lock page before
    # it can animate at all. So do not guess a time: look at the glass and
    # power off when it is black, or after 2 s whatever it shows.
    _stamp0="$(wake_stamp)"
    # `|| _ps=$?`: under set -e a bare non-zero return would end the script.
    _ps=0; panel_state || _ps=$?
    if [ "$_ps" -ne 1 ]; then
        page off
        wait_black
    fi
    # Woken while this was waiting (a double tap just after the screen began to
    # go off): the wake has already lit the panel and told the page. Leave it.
    if [ "$(wake_stamp)" != "$_stamp0" ]; then
        echo "taos-kiosk-screen: a wake arrived during the wait, leaving the panel on" >&2
        exit 0
    fi
    touch_events disabled
    swaymsg "output * power off" || _rc=$?
    # A wake can still land between the check above and the two lines after
    # it, and another check before them would only move that gap. So look
    # once more AFTER the panel is down. A wake stamps before it acts, so any
    # wake whose power-on could have come before this power-off has stamped
    # by now: put the panel and touch back. If the wake in fact acted after
    # the power-off, repeating its two steps changes nothing.
    if [ "$(wake_stamp)" != "$_stamp0" ]; then
        echo "taos-kiosk-screen: a wake arrived as the panel went off, powering it back on" >&2
        swaymsg "output * power on" >/dev/null 2>&1 || true
        touch_events enabled
        exit 0
    fi
    exit "${_rc:-0}"
    ;;
on)
    # Stamp first, so an off that is still waiting sees it before it acts.
    _w="$WAKE_STAMP.$$"
    # The pid makes every wake's stamp different whatever precision `date` has
    # here: two wakes in one second must not look like one.
    echo "$$.$(date +%s%N 2>/dev/null || date +%s)" > "$_w" 2>/dev/null && mv -f "$_w" "$WAKE_STAMP" 2>/dev/null || rm -f "$_w"
    swaymsg "output * power on" >/dev/null 2>&1 || true
    touch_events enabled
    page on
    # RE-ARM THE IDLE WATCHER. This lived in taos-kiosk-power until the power-on
    # moved here, and leaving it behind reintroduced the exact bug that comment
    # was written for: powering the output on over the IPC produces NO INPUT
    # EVENT, so swayidle never sees its `resume`, stays latched in the idle
    # state it entered, and never reaches its timeout again. Jay, minutes after
    # the move: "The screen doesnt seem to be turning off after 30 seconds".
    #
    # It belongs HERE because this is now the only place that powers the panel
    # on, so every wake path gets it -- the power key, the double tap, and
    # anything added later.
    #
    # Respawned through `swaymsg exec` rather than backgrounded from here: the
    # compositor then owns the watcher, starting it inside the sway session with
    # the session's environment and cgroup. A plain `setsid ... &` from this
    # script was MEASURED being reaped immediately on this image, leaving no
    # idle watcher at all -- strictly worse than the latched one.
    #
    # taos-kiosk-idle kills the previous instance before starting, so this
    # cannot stack watchers however often the screen is woken.
    swaymsg exec -- /usr/local/bin/taos-kiosk-idle >/dev/null 2>&1 || true
    ;;
*)
    echo "usage: taos-kiosk-screen off|on" >&2
    exit 2
    ;;
esac
