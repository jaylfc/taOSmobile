#!/bin/sh
# Turn the panel off or on, and gate TOUCH with it.
#
# WHY THIS EXISTS AS ITS OWN SCRIPT: "the screen is off" is two facts, not one --
# the output is powered down AND the digitiser must not reach the page. Three
# callers need both (the idle watcher, the power key, the double-tap watcher),
# and when each did its own half they drifted apart. Jay, from the glass:
# "Touchscreen is still registering events when the screen is off" -- taps in a
# pocket were pressing whatever was under the finger on the lock screen.
#
# THE REGRESSION THIS FIXES IS MINE. sway used to swallow the first touch
# because swayidle's `resume` was what powered the output back on, so the touch
# that woke the phone never reached the surface. Requiring a DOUBLE tap meant
# removing that `resume`, which also removed the swallowing -- so single touches
# started landing on the page while the screen was dark. The gate has to be
# explicit now that the wake is.
#
# ORDER IS DELIBERATE IN BOTH DIRECTIONS, and it is the whole point:
#   off: disable touch FIRST, then power down -- otherwise there is a window
#        where the screen is dark and the digitiser is still live, which is
#        exactly the bug.
#   on:  power up FIRST, then enable touch -- otherwise there is a window where
#        touch is live and the user cannot see what they are pressing.
#
# ⚠ SAFETY: with touch disabled, the ONLY way back is the power key, which is
# bound in sway with --locked and calls this script with `on`. So a dead
# double-tap watcher costs the double-tap, never the phone. Do not add a path
# that disables touch without leaving that key able to re-enable it.
set -eu

# type:touch rather than the identifier 0:0:fts_ts: a replacement digitiser or a
# kernel that renames the device would silently stop matching, and the failure
# mode of a non-matching selector here is the pocket-touch bug coming back with
# nothing in the logs.
TOUCH='type:touch'

touch_events() {
    swaymsg "input $TOUCH events $1" >/dev/null 2>&1 || true
}

# Tell the page the panel is going down or coming up.
#
# WHY THIS MATTERS AND IS NOT COSMETIC: the page CANNOT PAINT while the output
# is off -- Wayland stops delivering frame callbacks to a surface on a
# powered-down output. So whatever a waking panel shows is the last frame
# painted BEFORE it blanked, held in the scanout buffer. Jay, twice: "the lock
# screen still flashes into view first." It was that stale frame, not a
# transition.
#
# So the page is blackened here, while a compositor is still listening, and the
# pause is for it to actually paint that frame. Told on the way back too, or it
# would stay black on a lit panel.
page() {
    curl -sS --max-time 2 -X POST \
        "http://127.0.0.1:${TAOS_PORT:-6969}/auth/lock-screen-$1" \
        >/dev/null 2>&1 || true
}

case "${1:-}" in
off)
    page off
    # One frame at 60Hz is 16ms; 120 leaves room for chromium to lay out and
    # composite on a phone that may be busy. It is spent on a screen the user
    # has already stopped looking at.
    sleep 0.12
    touch_events disabled
    exec swaymsg "output * power off"
    ;;
on)
    swaymsg "output * power on" >/dev/null 2>&1 || true
    touch_events enabled
    page on
    # RE-ARM THE IDLE WATCHER. This lived in taos-kiosk-power until the power-on
    # moved here, and leaving it behind reintroduced the exact bug that comment
    # was written for: powering the output on over the IPC produces NO INPUT
    # EVENT, so swayidle never sees its `resume`, stays latched in the idle
    # state it entered, and never reaches its timeout again. Jay, minutes after
    # the move: "The screen doesnt seem to be turning off after 30 seconds".
    #
    # It belongs HERE because this is now the only place that powers the panel
    # on, so every wake path gets it -- the power key, the double tap, and
    # anything added later.
    #
    # Respawned through `swaymsg exec` rather than backgrounded from here: the
    # compositor then owns the watcher, starting it inside the sway session with
    # the session's environment and cgroup. A plain `setsid ... &` from this
    # script was MEASURED being reaped immediately on this image, leaving no
    # idle watcher at all -- strictly worse than the latched one.
    #
    # taos-kiosk-idle kills the previous instance before starting, so this
    # cannot stack watchers however often the screen is woken.
    swaymsg exec -- /usr/local/bin/taos-kiosk-idle >/dev/null 2>&1 || true
    ;;
*)
    echo "usage: taos-kiosk-screen off|on" >&2
    exit 2
    ;;
esac
