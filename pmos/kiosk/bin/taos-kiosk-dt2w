#!/usr/bin/env python3
"""Double-tap the dark screen to wake it.

WHY THIS EXISTS, AND WHY IT IS A RELIABILITY FIX RATHER THAN A NEW TRICK:
swayidle's `resume` fires on ANY input, so before this the panel lit up on a
single stray touch -- in a pocket, against a leg, brushing the desk. Jay, from
the glass: "Tap to wake just worked, i think it does sometimes just not when i
want it to!" A wake you cannot predict reads as a wake that does not work.
Requiring two deliberate taps makes it intentional in both directions: it stops
waking when you did not mean it, and it always wakes when you did.

THE MEASUREMENT THIS RESTS ON (2026-09-16, on the device): the digitiser stays
LIVE while sway has the panel powered down. BTN_TOUCH events were logged
arriving with the panel reading OFF. That is what makes a userspace daemon
possible at all -- this handset's FocalTech controller (fts_ts) exposes no
firmware gesture knob, so if the controller had slept with the panel the
feature would have needed a driver change.

WHY THE IPC-WAKE LATCH IN taos-kiosk-power DOES NOT BITE HERE: powering the
output on over the IPC produces no input event, so swayidle can stay latched in
its idle state and never time out again -- the bug behind "woken with the power
key, then lit forever". The wake below is always accompanied by REAL touch
input, which swayidle sees itself, so it resumes and re-arms on its own.

SAFETY: if this daemon dies, touch can no longer wake the panel, because
taos-kiosk-idle no longer powers the output on from `resume`. THE POWER KEY IS
THE FALLBACK and is bound independently in sway with --locked, so the screen is
never unreachable. That is the same fallback direction the kiosk URL rule takes:
every failure lands somewhere the user can still act.
"""
import json
import os
import struct
import subprocess
import sys
import time

# timeval (two longs) + type + code + value, the 64-bit input_event layout.
EVENT_FORMAT = "llHHi"
EVENT_SIZE = struct.calcsize(EVENT_FORMAT)
EV_KEY = 0x01
BTN_TOUCH = 0x14A

DEVICE = os.environ.get("TAOS_KIOSK_TOUCH_DEV", "/dev/input/event3")
# 400ms: comfortably above a deliberate double tap and below the gap between
# two separate intentional touches. Plasma uses a similar window.
WINDOW = float(os.environ.get("TAOS_KIOSK_DT2W_WINDOW", "0.4"))


def panel_is_off() -> bool:
    """Whether sway currently has the output powered down.

    Asks sway the same question taos-kiosk-power asks, deliberately: two
    different ways of reading the panel state would drift apart.

    On any failure this answers False -- a daemon that cannot see the panel
    state must not start powering it on at random.
    """
    try:
        out = subprocess.run(
            ["swaymsg", "-t", "get_outputs", "--raw"],
            capture_output=True, text=True, timeout=3,
        ).stdout
        # Parsed, not grepped. taos-kiosk-power greps this reply because it is a
        # POSIX shell with no jq; here there is a JSON parser in the language,
        # and `"power": false` vs `"power":false` is exactly the kind of
        # whitespace difference that makes a grep silently answer "on" forever.
        outputs = json.loads(out)
    except Exception:
        return False
    return any(o.get("power") is False for o in outputs)


def wake() -> None:
    """Power the panel up AND let touch through again.

    taos-kiosk-screen owns both halves. Calling `swaymsg "output * power on"`
    from here would light the screen and leave the digitiser gated, so the phone
    would look awake and ignore every tap.
    """
    subprocess.run(["/usr/local/bin/taos-kiosk-screen", "on"], timeout=8)


def main() -> int:
    try:
        # buffering=0: a buffered reader can hold a partial event or hand back
        # more than one at a time, and every event here is a fixed-size record
        # that must be read whole.
        dev = open(DEVICE, "rb", buffering=0)
    except OSError as exc:
        print("taos-kiosk-dt2w: cannot open %s: %s" % (DEVICE, exc), file=sys.stderr)
        return 1

    last_tap = 0.0
    print("taos-kiosk-dt2w: watching %s (window %.0fms)" % (DEVICE, WINDOW * 1000),
          file=sys.stderr)

    while True:
        # A blocking read on one descriptor. This costs nothing while the phone
        # is idle, which matters: the alternative -- polling -- would be a
        # battery regression that is invisible on the bench and obvious after a
        # night off the charger.
        data = dev.read(EVENT_SIZE)
        if not data or len(data) < EVENT_SIZE:
            continue
        _sec, _usec, etype, code, value = struct.unpack(EVENT_FORMAT, data)
        # Only the finger going DOWN counts. Counting releases as well would
        # make one tap look like two.
        if etype != EV_KEY or code != BTN_TOUCH or value != 1:
            continue

        now = time.monotonic()
        gap = now - last_tap
        last_tap = now

        if gap > WINDOW:
            continue
        # Consume the pair, so three taps are one wake and not two.
        last_tap = 0.0

        # Checked LAST, not first: while the panel is on, the page is handling
        # touches and this daemon has no business asking sway anything on every
        # tap the user makes.
        if panel_is_off():
            wake()

    return 0


if __name__ == "__main__":
    sys.exit(main())
