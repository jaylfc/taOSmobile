#!/usr/bin/make -f

include /usr/share/linux-packaging-snippets/kernel-snippet.mk

# Use clang's LLVM toolchain (LLVM=1) but the GNU assembler. This 5.4 kernel's
# arch/arm64/kernel/head.S uses an .ascii escape that clang-10's integrated
# assembler rejects; GNU as accepts it, matching the Halium build of this tree.
# The snippet hardcodes LLVM_IAS=1; a later assignment on the make line wins.
BUILD_COMMAND := $(BUILD_COMMAND) LLVM_IAS=0

# This is a GKI kernel: `make dtbs` builds no device DTB (the device tree is
# shipped separately by the vendor), so the snippet's dtb-merged step finds
# nothing and fails. The Ubuntu Touch port solves this the same way — it ships
# a prebuilt nothing-spacewar.dtb (deviceinfo_bootimg_prebuilt_dtb). Override
# the dtb-stamp recipe to drop that prebuilt into the kernel out tree, where
# the snippet's `find ... -iname *.dtb` then picks it up.
out/dtb-stamp: out/kernel-stamp.default
	-$(BUILD_COMMAND) dtbs
	mkdir -p $(KERNEL_OUT)/arch/$(KERNEL_ARCH)/boot
	cp debian/prebuilt/nothing-spacewar.dtb $(KERNEL_OUT)/arch/$(KERNEL_ARCH)/boot/nothing-spacewar.dtb
	touch $(OUT)/dtb-stamp

# vendor/lahaina_ALLYES_GKI.config is generated by the device's build.sh from
# lahaina_GKI.config, not checked into the tree. Reproduce that before configure.
override_dh_auto_configure:
	./scripts/gki/fragment_allyesconfig.sh \
		arch/arm64/configs/vendor/lahaina_GKI.config \
		arch/arm64/configs/vendor/lahaina_ALLYES_GKI.config
	dh_auto_configure

%:
	dh $@
