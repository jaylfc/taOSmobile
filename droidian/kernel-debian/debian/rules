#!/usr/bin/make -f

include /usr/share/linux-packaging-snippets/kernel-snippet.mk

# vendor/lahaina_ALLYES_GKI.config is not checked into the kernel tree — the
# device's build.sh generates it from lahaina_GKI.config before compiling.
# Reproduce that here, or the fragment stack is incomplete and the resulting
# kernel misses GKI-exported symbols.
override_dh_auto_configure:
	./scripts/gki/fragment_allyesconfig.sh \
		arch/arm64/configs/vendor/lahaina_GKI.config \
		arch/arm64/configs/vendor/lahaina_ALLYES_GKI.config
	dh_auto_configure

%:
	dh $@
