#!/usr/bin/make -f

include /usr/share/linux-packaging-snippets/kernel-snippet.mk

# clang for C, GNU as for assembly: clang-10's integrated assembler rejects an
# .ascii escape in this 5.4 kernel's head.S. Last make-line assignment wins.
BUILD_COMMAND := $(BUILD_COMMAND) LLVM_IAS=0

# GKI kernel: `make dtbs` builds no device tree (shipped separately by the
# vendor). Drop the prebuilt DTB into the out tree where the snippet's
# dtb-merged step looks, matching the UT port's prebuilt-dtb approach.
out/dtb-stamp: out/kernel-stamp.default
	-$(BUILD_COMMAND) dtbs
	mkdir -p $(KERNEL_OUT)/arch/$(KERNEL_ARCH)/boot
	cp debian/prebuilt/nothing-spacewar.dtb $(KERNEL_OUT)/arch/$(KERNEL_ARCH)/boot/nothing-spacewar.dtb
	touch $(OUT)/dtb-stamp

%:
	dh $@
