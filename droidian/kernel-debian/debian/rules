#!/usr/bin/make -f

include /usr/share/linux-packaging-snippets/kernel-snippet.mk

# Use clang's LLVM toolchain (LLVM=1) but the GNU assembler, not clang's
# integrated assembler. This 5.4 kernel's arch/arm64/kernel/head.S uses an
# .ascii escape that clang-10's integrated assembler rejects
# ("invalid escape sequence in .ascii directive"); GNU as accepts it, which is
# how the Halium/UT build of this same tree compiles. The snippet hardcodes
# LLVM_IAS=1; appending LLVM_IAS=0 here wins (make: last assignment on the
# command line takes effect).
BUILD_COMMAND := $(BUILD_COMMAND) LLVM_IAS=0

# vendor/lahaina_ALLYES_GKI.config is generated by the device's build.sh from
# lahaina_GKI.config, not checked into the tree. Reproduce that before the
# fragment stack is applied, or the config is incomplete.
override_dh_auto_configure:
	./scripts/gki/fragment_allyesconfig.sh \
		arch/arm64/configs/vendor/lahaina_GKI.config \
		arch/arm64/configs/vendor/lahaina_ALLYES_GKI.config
	dh_auto_configure

%:
	dh $@
