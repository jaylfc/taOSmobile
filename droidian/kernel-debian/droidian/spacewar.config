# Device config fragment for the Nothing Phone (1) (spacewar, SM7325).
# Applied on top of the vendor fragment stack; Droidian's own mandatory
# Halium/Droidian/pstore options come from common_fragments.

# Ensure the device-tree overlay is built (Qualcomm pattern).
CONFIG_BUILD_ARM64_DT_OVERLAY=y

# WLAN — SM7325 uses the Qualcomm CLD driver.
CONFIG_QCA_CLD_WLAN=y

# OTG
CONFIG_USB_OTG=y

# The UT port's droidian branch sets BINDERFS=n while gki_defconfig sets =y.
# Droidian's own droidian.config fragment also sets =n, and Waydroid relies on
# the binder devices list rather than binderfs, so take the Droidian default.
CONFIG_ANDROID_BINDERFS=n
