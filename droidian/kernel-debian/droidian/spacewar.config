# Device config fragment for the Nothing Phone (1) (spacewar, SM7325).
# Merged last (DEVICE_MODEL fragment), so it overrides the lahaina SoC stack
# (droidian/sm7325.config) and the Droidian common fragments.

# Build the device-tree overlay (Qualcomm).
CONFIG_BUILD_ARM64_DT_OVERLAY=y

# Do NOT build the in-tree Qualcomm WLAN driver (qcacld-3.0). On Halium the
# Wi-Fi module comes from the vendor partition as a prebuilt .ko, exactly as
# the Ubuntu Touch port uses it. Building it in-tree with this toolchain fails
# (wlan_hdd_state_ctrl_param_create implicit declaration), and is unnecessary.
# CONFIG_QCA_CLD_WLAN is not set

# USB OTG (harmless, useful).
CONFIG_USB_OTG=y

# Droidian prefers the binder device list over binderfs (see droidian.config).
CONFIG_ANDROID_BINDERFS=n
